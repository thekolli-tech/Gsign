# GSIGN Environment Variables

# Node & Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database (PostgreSQL 16+)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=gsign_dev_password
DB_NAME=gsign_db
DB_SSL=false

# Redis (Session & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets
SESSION_SECRET=gsign_session_secret_32_bytes_super_secure_random_key_2026
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_COOKIE_NAME=gsign_session
SESSION_MAX_AGE_SECONDS=86400
SESSION_IDLE_TIMEOUT_SECONDS=3600
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
